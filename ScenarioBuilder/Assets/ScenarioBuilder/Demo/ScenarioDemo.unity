      m_Calls: []
  m_text: "\u041E\u0442\u043A\u0440\u044B\u0442 \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D\u043D\u044B\u0439
    \u0436\u0443\u0440\u043D\u0430\u043B.\n\n\u0421\u043F\u0440\u0430\u0432\u0430
    \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u044B \u0435\u0433\u043E \u0441\u043E\u0431\u044B\u0442\u0438\u044F
    \u0438 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442. \u041C\u043E\u0436\u043D\u043E
    \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0434\u0440\u0443\u0433\u043E\u0439
    \u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0442\u043E\u0440 \u0431\u0435\u0437
    \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F.\n\n\u0427\u0442\u043E\u0431\u044B
    \u043D\u0430\u0447\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u0439 \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0439,
    \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0440\u0435\u0436\u0438\u043C
    \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u041D\u0430\u0447\u0430\u0442\u044C\xBB."
